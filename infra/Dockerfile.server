# One image, two processes: `node dist/api.js` and `node dist/worker.js`.
FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/server ./apps/server
RUN pnpm install --frozen-lockfile --filter @qf/server...
RUN pnpm --filter @qf/server build
RUN pnpm --filter @qf/server deploy --prod /out

FROM node:22-alpine
ENV NODE_ENV=production TZ=Asia/Kolkata
WORKDIR /app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /repo/apps/server/dist ./dist
USER node
EXPOSE 4000
CMD ["node", "dist/api.js"]
