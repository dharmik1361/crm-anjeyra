# Copy to .env for local dev. In production these come from AWS SSM Parameter Store.
NODE_ENV=development
PORT=4000
# Local: `pnpm dev` starts a dev MongoDB on 27018 (data in .mongo-dev/). Prod: Atlas Mumbai URL.
MONGO_URL=mongodb://127.0.0.1:27018/quotefollow
# Founder-only console access (S0). Used as the API bearer token and the web login.
ADMIN_TOKEN=change-me-to-a-long-random-string
API_URL=http://localhost:4000
# Sweeper interval in seconds
SWEEP_INTERVAL_SEC=60
TZ_DEFAULT=Asia/Kolkata
